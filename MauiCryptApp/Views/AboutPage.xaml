<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiCryptApp.Views.AboutPage"
             Title="AboutPage"
             xmlns:local="clr-namespace:MauiCryptApp.ViewModels"
             x:DataType="local:AboutViewModel">
    <VerticalStackLayout>
        <Label Text="Assembly Version:" />
        <Label Text="{Binding AssemblyVersion}" />
        <Label Text="Package Name:" />
        <Label Text="{Binding PackageName}" />
        <Label Text="Author:" />
        <Label Text="{Binding Author}" />
    </VerticalStackLayout>
</ContentPage>